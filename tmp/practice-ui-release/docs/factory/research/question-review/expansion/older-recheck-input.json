      "questions": [
        {
          "id": "exp26b-u15-005-q1",
          "type": "choice",
          "prompt": "After the entry pass, which Navy player is the carrier?",
          "options": [
            {
              "id": "a",
              "text": "F3"
            },
            {
              "id": "b",
              "text": "F2"
            },
            {
              "id": "c",
              "text": "YOU"
            }
          ],
          "answer": [
            "b"
          ],
          "basis": "scene",
          "explanation": "The setup assigns possession to F2 after the entry pass."
        },
        {
          "id": "exp26b-u15-005-q2",
          "type": "multi",
          "prompt": "Which two details matter when filling high support?",
          "options": [
            {
              "id": "a",
              "text": "F2's puck position"
            },
            {
              "id": "b",
              "text": "Gold's inside coverage"
            },
            {
              "id": "c",
              "text": "A high support spot chosen without checking F2’s lane"
            }
          ],
          "answer": [
            "a",
            "b"
          ],
          "basis": "coaching",
          "explanation": "Support follows the carrier and coverage; a fixed spot can crowd or disconnect the play."
        },
        {
          "id": "exp26b-u15-005-q3",
          "type": "sequence",
          "prompt": "Arrange the post-entry support change.",
          "options": [
            {
              "id": "a",
              "text": "Find F2 and the inside coverage"
            },
            {
              "id": "b",
              "text": "Offer a separated high lane"
            },
            {
              "id": "c",
              "text": "Re-check the carrier and exit"
            }
          ],
          "answer": [
            "a",
            "b",
            "c"
          ],
          "basis": "coaching",
          "explanation": "The support lane is useful only if it remains reachable from F2."
        },
        {
          "id": "exp26b-u15-005-q4",
          "type": "position",
          "prompt": "Move YOU into a high-slot support example after F2 receives.",
          "actorId": "h1",
          "reference": {
            "x": 20.5,
            "y": 4
          },
          "basis": "coaching",
          "explanation": "This gives F2 a higher connection while keeping the defenders visible."
        },
        {
          "id": "exp26b-u15-005-q5",
          "type": "choice",
          "prompt": "F2 loses the puck to Gold 2. What takes priority?",
          "options": [
            {
              "id": "a",
              "text": "Re-read the transition and recover toward the dangerous lane"
            },
            {
              "id": "b",
              "text": "Stay high waiting for F2"
            },
            {
              "id": "c",
              "text": "Assume the entry is still controlled"
            }
          ],
          "answer": [
            "a"
          ],
          "basis": "coaching",
          "explanation": "Possession changed, so the role changes before the old support route is continued."
        },
        {
          "id": "exp26b-u15-005-q6",
          "type": "explain",
          "prompt": "Which support space did YOU fill, and what route does it leave F2?",
          "basis": "coaching",
          "explanation": "A separated high-slot lane gives F2 a visible outlet or room to carry. If Gold closes it, re-offer from another reachable angle."
        }
