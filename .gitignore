*.log
coverage/

# Root-level data-processing artifacts (use tools/ for anything reusable)
/batch*.json
/output*.json
/truncated_*.json
/u13_*.json
/u13_*.txt
/u15_*.txt
/correct_answers_*.txt
/rewrite_manifest.txt
/_check*.js
/_check*.cjs

# Sync-script backup files (povQuestions.json.<timestamp>.bak) — local
# safety nets, not source of truth
src/data/*.bak
src/data/povQuestions.json.*.bak

# Scenario-factory work dirs + generated artifacts. Regenerated by
# gap-finder / brief-to-seed / contact-sheet; not source of truth. Approved
# seeds are promoted into src/scenario/seeds/ (which IS tracked).
docs/ai-pipeline/_briefs-todo/
docs/ai-pipeline/_needs-fixing/
docs/ai-pipeline/_pending-seeds/
docs/ai-pipeline/_instances/
docs/ai-pipeline/_convert-u13/
docs/ai-pipeline/_contact-sheet.html
docs/ai-pipeline/approved.json
docs/ai-pipeline/_signoff-log.jsonl

# Stray ChatGPT/browser image downloads dropped into the assets folder.
# Keep only intentionally-named scene PNGs (IMG-*, rink-*, etc.).
public/assets/images/* (*).png
public/assets/images/ChatGPT Image *.png
